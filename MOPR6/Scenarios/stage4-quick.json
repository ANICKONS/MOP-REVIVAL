{
  "Name": "stage4-quick",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 one session: 1) script sleep now also on objects with several FSMs - verify (virtual sleep) at home, at the car and driving, mismatches must be 0; then on, A/B by its own switch driving and at home. 2) world.vehicles with the boat: what is frozen, A/B. 3) Satsuma merge again, now that the parked Satsuma is frozen: the check cost and A/B. 4) Ledger: restore, a save." },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },
    { "Op": "mopr", "Text": "verify sleep.idle" },

    { "Op": "log", "Text": "=== 1. Verify" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 20 },
    { "Op": "moprapi", "Text": "Report", "Label": "v-home" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-6.5, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "moprapi", "Text": "Report", "Label": "v-car" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 25 },
    { "Op": "moprapi", "Text": "Report", "Label": "v-drive" },

    { "Op": "log", "Text": "=== 2. On" },
    { "Op": "mopr", "Text": "on sleep.idle" },
    { "Op": "wait", "Seconds": 12 },
    { "Op": "abtoggle", "Label": "drive-sleep", "Var": "mopr6ab", "Path": "sleep.idle", "Seconds": 20, "Block": 1 },
    { "Op": "abtoggle", "Label": "drive-vehicles", "Var": "mopr6ab", "Path": "world.vehicles", "Seconds": 16, "Block": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "drive" },
    { "Op": "autodrivestop" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Motor OFF" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "abtoggle", "Label": "home-sleep", "Var": "mopr6ab", "Path": "sleep.idle", "Seconds": 20, "Block": 1 },
    { "Op": "abtoggle", "Label": "home-vehicles", "Var": "mopr6ab", "Path": "world.vehicles", "Seconds": 16, "Block": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "home" },

    { "Op": "log", "Text": "=== 3. Satsuma merge, the Satsuma frozen 25 m away" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, -25.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "mopr", "Text": "on render.merge" },
    { "Op": "wait", "Seconds": 12 },
    { "Op": "moprapi", "Text": "Report", "Label": "merge" },
    { "Op": "abtoggle", "Label": "car25-merge", "Var": "mopr6ab", "Path": "render.merge", "Seconds": 20, "Block": 1 },
    { "Op": "abshot", "Label": "car25-merge", "Path": "render.merge", "Var": "ab", "Seconds": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "merge2" },
    { "Op": "mopr", "Text": "off render.merge" },

    { "Op": "log", "Text": "=== 4. Ledger" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "mopr", "Text": "restore" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "savegame" },
    { "Op": "mopr", "Text": "barrier" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
