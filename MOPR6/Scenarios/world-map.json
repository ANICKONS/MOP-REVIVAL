{
  "Name": "world-map",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 stage 4 cost map, one session with the default systems (exact + script sleep). Where the frame goes per root object (script profile: every Update/FixedUpdate/LateUpdate, FSMs included) in the living room, in the yard and while driving; and what the candidate world actions would save, as 1 s A/B: the other vehicles parked (root kinematic + UnityCar behaviours off), the same vehicles switched off (upper bound), the places of 5.x switched off (upper bound), every item kinematic." },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },
    { "Op": "mopr", "Text": "status" },

    { "Op": "log", "Text": "=== 1. Living room" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 12 },
    { "Op": "profile", "Label": "home", "Seconds": 15 },
    { "Op": "abtoggle", "Label": "home-cars-parked", "Var": "unitycar", "Path": "FERNDALE(1630kg);HAYOSIKO(1500kg, 250);GIFU(750/450psi);KEKMET(350-400psi);RCO_RUSCKO12(270);JONNEZ ES(Clone);FLATBED;COMBINE(350-400psi);BOAT", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "home-cars-off", "Var": "active", "Path": "FERNDALE(1630kg);HAYOSIKO(1500kg, 250);GIFU(750/450psi);KEKMET(350-400psi);RCO_RUSCKO12(270);JONNEZ ES(Clone);FLATBED;COMBINE(350-400psi);BOAT", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "home-places-off", "Var": "active", "Path": "PERAJARVI;CABIN;COTTAGE;DANCEHALL;SOCCER;WATERFACILITY;MAP/Buildings/DINGONBIISI;RALLY/PartsSalesman;STORE;REPAIRSHOP;INSPECTION;LANDFILL;JOBS", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "home-items-kinematic", "Var": "kinematic", "Path": "ITEMS", "Text": "*", "Seconds": 12, "Block": 1 },

    { "Op": "log", "Text": "=== 2. Yard" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, -25.0], "Target": "YARD/Building" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "profile", "Label": "yard", "Seconds": 15 },
    { "Op": "abtoggle", "Label": "yard-cars-parked", "Var": "unitycar", "Path": "FERNDALE(1630kg);HAYOSIKO(1500kg, 250);GIFU(750/450psi);KEKMET(350-400psi);RCO_RUSCKO12(270);JONNEZ ES(Clone);FLATBED;COMBINE(350-400psi);BOAT", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-places-off", "Var": "active", "Path": "PERAJARVI;CABIN;COTTAGE;DANCEHALL;SOCCER;WATERFACILITY;MAP/Buildings/DINGONBIISI;RALLY/PartsSalesman;STORE;REPAIRSHOP;INSPECTION;LANDFILL;JOBS", "Seconds": 16, "Block": 1 },

    { "Op": "log", "Text": "=== 3. Drive" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "profile", "Label": "drive", "Seconds": 15 },
    { "Op": "abtoggle", "Label": "drive-cars-parked", "Var": "unitycar", "Path": "FERNDALE(1630kg);HAYOSIKO(1500kg, 250);GIFU(750/450psi);KEKMET(350-400psi);RCO_RUSCKO12(270);JONNEZ ES(Clone);FLATBED;COMBINE(350-400psi);BOAT", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "drive-places-off", "Var": "active", "Path": "CABIN;COTTAGE;DANCEHALL;SOCCER;WATERFACILITY;MAP/Buildings/DINGONBIISI;RALLY/PartsSalesman;STORE;REPAIRSHOP;INSPECTION;LANDFILL;JOBS", "Seconds": 16, "Block": 1 },
    { "Op": "autodrivestop" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
