{
  "Name": "quick",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 quick check in one session (real frame times, not deterministic). 1) Every exact system in Verify: home, next to the Satsuma, a real drive - mismatches must be 0. 2) A/B of the systems (off / on every second): driving, living room, next to the car, then each system alone next to the car. 3) Ledger and save barrier: the test probe hides the living room, restore, hide again, save - nothing may stay changed." },
    { "Op": "mopr", "Text": "status" },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },

    { "Op": "log", "Text": "=== 1. Verify" },
    { "Op": "mopr", "Text": "sys all verify" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "verify-home" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "verify-yard" },

    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 30 },
    { "Op": "watch", "Label": "drive", "Seconds": 0, "Probes": [ "drv=static|MOPR.TestBot.AutoDriver.Status" ] },
    { "Op": "moprapi", "Text": "Report", "Label": "verify-drive" },
    { "Op": "mopr", "Text": "verify" },

    { "Op": "log", "Text": "=== 2. A/B (A = systems off, B = on)" },
    { "Op": "mopr", "Text": "sys all on" },
    { "Op": "abtoggle", "Label": "drive-all", "Var": "mopr6", "Path": "all", "Seconds": 24, "Block": 1 },
    { "Op": "autodrivestop" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "abtoggle", "Label": "seated-all", "Var": "mopr6", "Path": "all", "Seconds": 16, "Block": 1 },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-2.5, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "abtoggle", "Label": "car-all", "Var": "mopr6", "Path": "all", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "car-fsm", "Var": "mopr6", "Path": "engine.fsm", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "car-property", "Var": "mopr6", "Path": "engine.property", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "car-mouseray", "Var": "mopr6", "Path": "engine.mouseray", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "car-ik", "Var": "mopr6", "Path": "engine.ik", "Seconds": 12, "Block": 1 },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "abtoggle", "Label": "home-all", "Var": "mopr6", "Path": "all", "Seconds": 16, "Block": 1 },
    { "Op": "mopr", "Text": "sys all on" },
    { "Op": "moprapi", "Text": "Report", "Label": "on" },

    { "Op": "log", "Text": "=== 3. Ledger and save barrier" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "mopr", "Text": "probe hide YARD/Building/LIVINGROOM" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "moprapi", "Text": "LedgerDump", "Label": "hidden" },
    { "Op": "mopr", "Text": "restore" },
    { "Op": "mopr", "Text": "ledger" },
    { "Op": "mopr", "Text": "probe hide YARD/Building/LIVINGROOM" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "mopr", "Text": "barrier" },
    { "Op": "savegame" },
    { "Op": "mopr", "Text": "barrier" },
    { "Op": "mopr", "Text": "status" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
