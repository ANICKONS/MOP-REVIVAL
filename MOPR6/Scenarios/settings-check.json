{
  "Name": "settings-check",
  "SettleSeconds": 8,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 settings, console and report (tasks 27-28), one short session: 1) console in English (TestApi) - status, catalog, report text; 2) the main switch from the console with the test probe holding changes: off returns everything and stops every system, a system cannot be switched on while it is off, on brings the systems back; verify of all systems for 15 s: 0 mismatches; 3) the settings page like the user: language Russian (console lines in Russian), main switch off / on, one system off; 4) update check against GitHub, import of the 5.x settings, errors." },
    { "Op": "mopr", "Text": "status" },
    { "Op": "mopr", "Text": "catalog" },
    { "Op": "mopr", "Text": "lang" },
    { "Op": "moprapi", "Text": "BugReportText", "Label": "report" },

    { "Op": "log", "Text": "=== 2. Main switch from the console" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "mopr", "Text": "probe hide YARD/Building/LIVINGROOM" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "mopr", "Text": "off" },
    { "Op": "mopr", "Text": "ledger" },
    { "Op": "mopr", "Text": "on engine.fsm" },
    { "Op": "moprapi", "Text": "Systems", "Label": "off" },
    { "Op": "mopr", "Text": "on" },
    { "Op": "moprapi", "Text": "Systems", "Label": "on" },
    { "Op": "mopr", "Text": "verify all" },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "mopr", "Text": "verify" },
    { "Op": "mopr", "Text": "on all" },

    { "Op": "log", "Text": "=== 3. The settings page like the user" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "language", "Value": "1" },
    { "Op": "console", "Text": "mopr verify" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "enabled", "Value": "false" },
    { "Op": "moprapi", "Text": "Systems", "Label": "page-off" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "enabled", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "sys.engine.ik", "Value": "false" },
    { "Op": "moprapi", "Text": "Systems", "Label": "page-on" },
    { "Op": "dumpsettings", "Text": "MOPR6", "Label": "ru" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "sys.engine.ik", "Value": "true" },

    { "Op": "log", "Text": "=== 4. Update check, import, errors" },
    { "Op": "console", "Text": "mopr update" },
    { "Op": "wait", "Seconds": 12 },
    { "Op": "console", "Text": "mopr import5" },
    { "Op": "console", "Text": "mopr help" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "language", "Value": "2" },
    { "Op": "console", "Text": "mopr status" },
    { "Op": "modsetting", "Text": "MOPR6", "Var": "language", "Value": "0" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
