{
  "Name": "render-quick",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 render stage quick check in one session (real frame times). 1) Living room, next to the parked Satsuma, a view over the yard: what the render systems hold, the picture with the game paused (render off / on: shot_*_a/_b.png), A/B of the render systems and of the Satsuma merge alone (merged / originals drawn). 2) A real drive: A/B while driving. 3) Ledger: restore everything, the systems take their changes again, a save: nothing may stay changed; after the reload the systems work again." },
    { "Op": "mopr", "Text": "status" },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },

    { "Op": "log", "Text": "=== 1. Home, car, yard" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "home" },
    { "Op": "abshot", "Label": "home", "Path": "render", "Seconds": 6 },
    { "Op": "abtoggle", "Label": "home-render", "Var": "mopr6", "Path": "render", "Seconds": 16, "Block": 1 },
    { "Op": "mopr", "Text": "on render" },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-6.5, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "car" },
    { "Op": "abshot", "Label": "car", "Path": "render", "Seconds": 8 },
    { "Op": "abtoggle", "Label": "car-merge", "Var": "mopr6ab", "Path": "render.merge", "Seconds": 20, "Block": 1 },
    { "Op": "abtoggle", "Label": "car-shadows", "Var": "mopr6", "Path": "render.shadows", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "car-layers", "Var": "mopr6", "Path": "render.layers", "Seconds": 12, "Block": 1 },
    { "Op": "mopr", "Text": "on render" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "moprapi", "Text": "Report", "Label": "car2" },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, -25.0], "Target": "YARD/Building" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "abshot", "Label": "yard", "Path": "render", "Seconds": 8 },
    { "Op": "abtoggle", "Label": "yard-merge", "Var": "mopr6ab", "Path": "render.merge", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-render", "Var": "mopr6", "Path": "render", "Seconds": 16, "Block": 1 },
    { "Op": "mopr", "Text": "on render" },

    { "Op": "log", "Text": "=== 2. Drive" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 20 },
    { "Op": "moprapi", "Text": "Report", "Label": "drive" },
    { "Op": "abtoggle", "Label": "drive-render", "Var": "mopr6", "Path": "render", "Seconds": 24, "Block": 1 },
    { "Op": "mopr", "Text": "on render" },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 3 },

    { "Op": "log", "Text": "=== 3. Ledger" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-6.5, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "before-restore" },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "mopr", "Text": "restore" },
    { "Op": "mopr", "Text": "ledger" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "savegame" },
    { "Op": "mopr", "Text": "barrier" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "after-save" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
