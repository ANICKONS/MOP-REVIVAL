    { "Op": "mopr", "Text": "off sleep.idle" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "home-off-2", "Seconds": 15 },
    { "Op": "mopr", "Text": "on sleep.idle" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "measure", "Label": "home-on-2", "Seconds": 15 },
    { "Op": "moprapi", "Text": "Report", "Label": "home-on-2" },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-6.5, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "mopr", "Text": "off sleep.idle" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "car-off-1", "Seconds": 15 },
    { "Op": "mopr", "Text": "on sleep.idle" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "measure", "Label": "car-on-1", "Seconds": 15 },
    { "Op": "mopr", "Text": "off sleep.idle" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "car-off-2", "Seconds": 15 },
