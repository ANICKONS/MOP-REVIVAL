  "Steps": [
    { "Op": "log", "Text": "MOPR6 script sleep (sleep.idle): steady windows, no fast switching. The system removed (all awake, no hooks) and installed (asleep after a few seconds, measured from 8 s after the install), twice each (off, on, off, on), in the living room and next to the car. Checks the 1 s A/B of the system's own switch (+2.6 ms at home) against the install / remove A/B with 6 s blocks (+0.7 ms)." },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "mopr", "Text": "off sleep.idle" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "home-off-1", "Seconds": 15 },
    { "Op": "mopr", "Text": "on sleep.idle" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "moprapi", "Text": "Report", "Label": "home-on-1" },
