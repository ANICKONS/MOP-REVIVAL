{
  "Name": "world-vehicles",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 world.vehicles (parked vehicles frozen) in one session. 1) Living room and yard: what is frozen, A/B by the system's own switch. Then the cost of each 5.x place switched off (upper bound, 1 s A/B) from the yard, for the next world system. 2) A real drive: A/B. Stop, get out, walk 40 m away: the Satsuma must freeze; come back, get in, drive off: it must thaw. 3) Ledger: restore, a save - nothing may stay changed." },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },
    { "Op": "mopr", "Text": "on world.vehicles" },

    { "Op": "log", "Text": "=== 1. Home" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 12 },
    { "Op": "moprapi", "Text": "Report", "Label": "home" },
    { "Op": "abtoggle", "Label": "home-vehicles", "Var": "mopr6ab", "Path": "world.vehicles", "Seconds": 20, "Block": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, -25.0], "Target": "YARD/Building" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "abtoggle", "Label": "yard-vehicles", "Var": "mopr6ab", "Path": "world.vehicles", "Seconds": 20, "Block": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "yard" },
    { "Op": "abtoggle", "Label": "yard-PERAJARVI", "Var": "active", "Path": "PERAJARVI", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-CABIN", "Var": "active", "Path": "CABIN", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-COTTAGE", "Var": "active", "Path": "COTTAGE", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-DANCEHALL", "Var": "active", "Path": "DANCEHALL", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-SOCCER", "Var": "active", "Path": "SOCCER", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-WATERFACILITY", "Var": "active", "Path": "WATERFACILITY", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-STORE", "Var": "active", "Path": "STORE", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-REPAIRSHOP", "Var": "active", "Path": "REPAIRSHOP", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-INSPECTION", "Var": "active", "Path": "INSPECTION", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-LANDFILL", "Var": "active", "Path": "LANDFILL", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-JOBS", "Var": "active", "Path": "JOBS", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-HUMANS", "Var": "active", "Path": "HUMANS", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-TRAIN", "Var": "active", "Path": "TRAIN", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-BOAT", "Var": "active", "Path": "BOAT", "Seconds": 12, "Block": 1 },
    { "Op": "abtoggle", "Label": "yard-ITEMS", "Var": "kinematic", "Path": "ITEMS", "Text": "*", "Seconds": 12, "Block": 1 },

    { "Op": "log", "Text": "=== 2. Drive" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "abtoggle", "Label": "drive-vehicles", "Var": "mopr6ab", "Path": "world.vehicles", "Seconds": 24, "Block": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "drive" },
    { "Op": "autodrivestop" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Motor OFF" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "watch", "Label": "satsuma-near", "Seconds": 0, "Probes": [ "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic", "dt=SATSUMA(557kg, 248)|#Drivetrain.enabled", "player=global|PlayerCurrentVehicle" ] },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.0, -40.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "satsuma-away", "Seconds": 0, "Probes": [ "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic", "dt=SATSUMA(557kg, 248)|#Drivetrain.enabled" ] },
    { "Op": "moprapi", "Text": "Report", "Label": "away" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "satsuma-back", "Seconds": 0, "Probes": [ "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic" ] },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 30 },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "satsuma-driving-again", "Seconds": 0, "Probes": [ "drv=static|MOPR.TestBot.AutoDriver.Status", "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic" ] },
    { "Op": "autodrivestop" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 3 },

    { "Op": "log", "Text": "=== 3. Ledger" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "before-restore" },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "mopr", "Text": "restore" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "savegame" },
    { "Op": "mopr", "Text": "barrier" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
