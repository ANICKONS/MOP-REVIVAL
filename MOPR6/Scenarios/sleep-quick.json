{
  "Name": "sleep-quick",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR6 script sleep (sleep.idle) quick check in one session. 0) Which FSM actions name a PlayMakerFSM component or switch behaviours (would anything see a sleeper as disabled). 1) Verify (virtual sleep, nothing disabled): home, next to the car, a real drive; mismatches must be 0. 2) On: the drive, then home, A/B by the system's own switch (A = all awake, B = asleep again). 3) Ledger: restore, a save - nothing may stay changed." },
    { "Op": "mopr", "Text": "status" },
    { "Op": "activate", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN", "Active": false },
    { "Op": "fsmgrep", "Text": "playmakerfsm,enablebehaviour", "Detail": true, "Max": 3000, "Label": "fsm-enabled" },

    { "Op": "log", "Text": "=== 1. Verify" },
    { "Op": "mopr", "Text": "verify sleep.idle" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 20 },
    { "Op": "moprapi", "Text": "Report", "Label": "v-home" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-6.5, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "moprapi", "Text": "Report", "Label": "v-car" },

    { "Op": "log", "Text": "=== 2. Drive: verify, then on" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 25 },
    { "Op": "moprapi", "Text": "Report", "Label": "v-drive" },
    { "Op": "mopr", "Text": "on sleep.idle" },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "moprapi", "Text": "Report", "Label": "drive" },
    { "Op": "abtoggle", "Label": "drive-sleep", "Var": "mopr6ab", "Path": "sleep.idle", "Seconds": 24, "Block": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "drive2" },
    { "Op": "autodrivestop" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "abtoggle", "Label": "seated-sleep", "Var": "mopr6ab", "Path": "sleep.idle", "Seconds": 16, "Block": 1 },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 3 },

    { "Op": "log", "Text": "=== 3. Home, on" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "moprapi", "Text": "Report", "Label": "home" },
    { "Op": "abtoggle", "Label": "home-sleep", "Var": "mopr6ab", "Path": "sleep.idle", "Seconds": 20, "Block": 1 },
    { "Op": "moprapi", "Text": "Report", "Label": "home2" },

    { "Op": "log", "Text": "=== 4. Ledger" },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "mopr", "Text": "restore" },
    { "Op": "mopr", "Text": "ledger" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "moprapi", "Text": "LedgerCount" },
    { "Op": "savegame" },
    { "Op": "mopr", "Text": "barrier" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "moprapi", "Text": "Report", "Label": "after-save" },
    { "Op": "mopr", "Text": "errors" },
    { "Op": "quit" }
  ]
}
