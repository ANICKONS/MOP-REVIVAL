{
  "Name": "drive-modes3",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Cost of the Satsuma's FSMs that only wait for events (the per-bolt Screw FSMs in Idle) and of all its FSMs, seated in Peraejaervi: switched off in 1 s blocks, with MOPR's PlayMaker fast path on and off. Experimental options off." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "false" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle" ] },
    { "Op": "picked", "Label": "bolts", "Path": "SATSUMA(557kg, 248)", "Text": "BoltPM*" },
    { "Op": "picked", "Label": "car", "Path": "SATSUMA(557kg, 248)", "Text": "Body;MiscParts;Chassis;Dashboard;Interior;FL;FR;RL;RR;CarSimulation;Electricity;Wiring" },

    { "Op": "log", "Text": "--- fast path ON ---" },
    { "Op": "abtoggle", "Label": "fastpath-screw-fsms", "Var": "fsms", "Path": "SATSUMA(557kg, 248)", "Text": "BoltPM*", "Seconds": 20, "Block": 1 },
    { "Op": "abtoggle", "Label": "fastpath-all-car-fsms", "Var": "behaviours", "Path": "SATSUMA(557kg, 248)", "Text": "PlayMakerFSM", "Seconds": 20, "Block": 1 },

    { "Op": "log", "Text": "--- fast path OFF ---" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerFastPath", "Value": "false" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "abtoggle", "Label": "original-screw-fsms", "Var": "fsms", "Path": "SATSUMA(557kg, 248)", "Text": "BoltPM*", "Seconds": 20, "Block": 1 },
    { "Op": "abtoggle", "Label": "original-all-car-fsms", "Var": "behaviours", "Path": "SATSUMA(557kg, 248)", "Text": "PlayMakerFSM", "Seconds": 20, "Block": 1 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerFastPath", "Value": "true" },
    { "Op": "quit" }
  ]
}
