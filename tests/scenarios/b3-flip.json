{
  "Name": "b3-flip",
  "SettleSeconds": 3,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "B3 (Satsuma flips or 'explodes' when MOP switches it on, parc ferme). 1) Something else moves the car while MOP has its physics off (a mod, the game): does MOP's ForceRotation put it back? 2) Physics back on: velocity and tilt right after. 3) The rally parc ferme: the car set down there, then away / back three times." },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "start", "Seconds": 0, "Probes": [ "pos=SATSUMA(557kg, 248)|@pos", "up=SATSUMA(557kg, 248)|#Transform.up", "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic" ] },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [30.0, 3.0, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
