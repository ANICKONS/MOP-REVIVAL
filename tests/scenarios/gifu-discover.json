{
  "Name": "gifu-discover",
  "SettleSeconds": 15,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Gifu: where its seat, ignition, gears, brakes and colliders are (dumps), and what MOPR has set on it when the player walks up to it from far away." },
    { "Op": "teleport", "Path": "GIFU(750/450psi)", "Local": true, "Pos": [-4.0, 1.0, 0.0], "Target": "GIFU(750/450psi)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "near", "Seconds": 0, "Probes": [
      "pos=GIFU(750/450psi)|@pos", "active=GIFU(750/450psi)|@active", "kin=GIFU(750/450psi)|#Rigidbody.isKinematic",
      "grav=GIFU(750/450psi)|#Rigidbody.useGravity", "cd=GIFU(750/450psi)|#CarDynamics.enabled", "ax=GIFU(750/450psi)|#Axles.enabled",
      "coll=GIFU(750/450psi)/Colliders|@parent", "dummy=MOP/MOP_DumbObjects/MOP_Dumb-GIFU(750/450psi)|@active", "player=GIFU(750/450psi)|@player" ] },
    { "Op": "find", "Label": "gifu", "Text": "GIFU(750/450psi)", "Max": 50 },
    { "Op": "fsmgrep", "Label": "gifu_seat", "Text": "Player in car,Key DOWN,PLAYERINCAR,DriveTrigger", "Max": 300 },
    { "Op": "dumpfsm", "Label": "gifu_root", "Path": "GIFU(750/450psi)", "Recursive": false },
    { "Op": "dumpfsm", "Label": "gifu_lod", "Path": "GIFU(750/450psi)/LOD", "Recursive": false },
    { "Op": "dumpfsm", "Label": "gifu_playertrigger", "Path": "GIFU(750/450psi)/LOD/PlayerTrigger", "Recursive": true },
    { "Op": "dumpfsm", "Label": "gifu_dashboard", "Path": "GIFU(750/450psi)/LOD/Dashboard", "Recursive": true },
    { "Op": "dumpfsm", "Label": "gifu_simulation", "Path": "GIFU(750/450psi)/Simulation", "Recursive": true },
    { "Op": "quit" }
  ]
}
