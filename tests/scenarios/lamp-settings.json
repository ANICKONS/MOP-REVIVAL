{
  "Name": "lamp-settings",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "1) Satsuma interior lamp seen through the roof: geometry check and screenshots, merger off and on. 2) Settings changed in game apply at once." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "false" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, 20.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "movecar", "Target": "SATSUMA(557kg, 248)", "Pos": [0.0, 0.3, 13.0] },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-4.5, 1.6, 0.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },

    { "Op": "log", "Text": "--- the lamp: structure, state machines, does it stick out of the roof ---" },
    { "Op": "tree", "Label": "interior_light", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight", "Max": 4 },
    { "Op": "dumpfsm", "Label": "interior_light", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight", "Recursive": true },
    { "Op": "watch", "Label": "lamp_pose", "Seconds": 0, "Probes": [
        "lamp=SATSUMA(557kg, 248)/Interior/InteriorLight|#Transform.localPosition",
        "lamprot=SATSUMA(557kg, 248)/Interior/InteriorLight|#Transform.localEulerAngles",
        "pivot=SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot|#Transform.localPosition",
        "pivotrot=SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot|#Transform.localEulerAngles",
        "cube=SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube|#Transform.localPosition",
        "cuberot=SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube|#Transform.localEulerAngles",
        "cubescale=SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube|#Transform.localScale" ] },
    { "Op": "meshclip", "Label": "cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Target": "SATSUMA(557kg, 248)" },
    { "Op": "meshclip", "Label": "lens", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Light/light", "Target": "SATSUMA(557kg, 248)" },
    { "Op": "camshot", "Label": "side", "Target": "SATSUMA(557kg, 248)", "Anchor": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Pos": [-0.9, 0.55, 0.0], "Max": 40 },
    { "Op": "camshot", "Label": "front", "Target": "SATSUMA(557kg, 248)", "Anchor": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Pos": [0.0, 0.6, 0.9], "Max": 40 },
    { "Op": "camshot", "Label": "close", "Target": "SATSUMA(557kg, 248)", "Anchor": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Pos": [-0.35, 0.3, 0.1], "Max": 30 },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Active": false },
    { "Op": "camshot", "Label": "close_nocube", "Target": "SATSUMA(557kg, 248)", "Anchor": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Pos": [-0.35, 0.3, 0.1], "Max": 30 },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Active": true },

    { "Op": "log", "Text": "--- merger on: same views ---" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "true" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "merged", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged" ] },
    { "Op": "camshot", "Label": "side_merged", "Target": "SATSUMA(557kg, 248)", "Anchor": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Pos": [-0.9, 0.55, 0.0], "Max": 40 },
    { "Op": "camshot", "Label": "close_merged", "Target": "SATSUMA(557kg, 248)", "Anchor": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Path": "SATSUMA(557kg, 248)/Interior/InteriorLight/Pivot/Cube", "Pos": [-0.35, 0.3, 0.1], "Max": 30 },

    { "Op": "log", "Text": "--- merger off and on again in game: the render optimizer takes the Satsuma back / hands it over ---" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "false" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "true" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "remerged", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },

    { "Op": "log", "Text": "--- performance mode changed in game: the note under the modes ---" },
    { "Op": "watch", "Label": "mode_before", "Seconds": 0, "Probes": [ "mode=static|MOP.Common.MopSettings.Mode", "loaded=static|MOP.Common.MopSettings.LoadedMode", "note=static|MOP.MopMenu.restartNoticeVisible" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "modeBalanced", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "modePerformance", "Value": "true" },
    { "Op": "watch", "Label": "mode_performance", "Seconds": 0, "Probes": [ "mode=static|MOP.Common.MopSettings.Mode", "loaded=static|MOP.Common.MopSettings.LoadedMode", "note=static|MOP.MopMenu.restartNoticeVisible" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "modePerformance", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "modeBalanced", "Value": "true" },
    { "Op": "watch", "Label": "mode_back", "Seconds": 0, "Probes": [ "mode=static|MOP.Common.MopSettings.Mode", "loaded=static|MOP.Common.MopSettings.LoadedMode", "note=static|MOP.MopMenu.restartNoticeVisible" ] },

    { "Op": "log", "Text": "--- dynamic draw distance switched off inside a sector (sauna, 300 m) ---" },
    { "Op": "teleport", "Pos": [-12.5, 0.4, 1.2], "Yaw": 0 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "camstate", "Label": "sector_on" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "dynamicDrawDistance", "Value": "false" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "camstate", "Label": "sector_off" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "dynamicDrawDistance", "Value": "true" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "camstate", "Label": "sector_on_again" },
    { "Op": "quit" }
  ]
}
