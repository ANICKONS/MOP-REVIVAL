{
  "Name": "satsuma-gpu",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Is the drop near the Satsuma GPU-bound? Frame time vs resolution near and far, per-pixel lights, lights around." },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [8.0, 2.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "lights", "Seconds": 40 },
    { "Op": "measure", "Label": "8m-720p", "Seconds": 6 },
    { "Op": "resolution", "Pos": [640, 360] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "8m-360p", "Seconds": 6 },
    { "Op": "resolution", "Pos": [1920, 1080] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "8m-1080p", "Seconds": 6 },
    { "Op": "resolution", "Pos": [1280, 720] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "8m-720p-again", "Seconds": 6 },
    { "Op": "quality", "Var": "pixelLightCount", "Value": "0" },
    { "Op": "measure", "Label": "8m-no-pixel-lights", "Seconds": 6 },
    { "Op": "quality", "Var": "pixelLightCount", "Value": "restore" },
    { "Op": "renderers", "Path": "SATSUMA(557kg, 248)", "Active": false },
    { "Op": "resolution", "Pos": [640, 360] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "8m-360p-car-not-drawn", "Seconds": 6 },
    { "Op": "resolution", "Pos": [1280, 720] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "8m-720p-car-not-drawn", "Seconds": 6 },
    { "Op": "renderers", "Path": "SATSUMA(557kg, 248)", "Active": true },

    { "Op": "log", "Text": "--- Chassis group (MOP enables it within 20 m): 15 m, looking away ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [15.0, 3.0, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "census", "Path": "SATSUMA(557kg, 248)/Chassis" },
    { "Op": "measure", "Label": "15m-away-base", "Seconds": 6 },
    { "Op": "colliders", "Path": "SATSUMA(557kg, 248)/Chassis", "Active": false },
    { "Op": "measure", "Label": "15m-away-chassis-no-colliders", "Seconds": 6 },
    { "Op": "colliders", "Path": "SATSUMA(557kg, 248)/Chassis", "Active": true },
    { "Op": "renderers", "Path": "SATSUMA(557kg, 248)/Chassis", "Active": false },
    { "Op": "measure", "Label": "15m-away-chassis-not-drawn", "Seconds": 6 },
    { "Op": "renderers", "Path": "SATSUMA(557kg, 248)/Chassis", "Active": true },
    { "Op": "measure", "Label": "15m-away-base-again", "Seconds": 6 },

    { "Op": "log", "Text": "--- Unity dispatch cost: 1000 empty MonoBehaviours (Update + LateUpdate), 40 m away ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [40.0, 4.0, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "40m-away-720p", "Seconds": 6 },
    { "Op": "dummies", "Max": 1000 },
    { "Op": "measure", "Label": "40m-away-1000-dummies", "Seconds": 6 },
    { "Op": "dummies", "Max": 0 },
    { "Op": "measure", "Label": "40m-away-720p-again", "Seconds": 6 },
    { "Op": "resolution", "Pos": [640, 360] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "40m-away-360p", "Seconds": 6 },
    { "Op": "resolution", "Pos": [1280, 720] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "quit" }
  ]
}
