{
  "Name": "b1-verify",
  "SettleSeconds": 15,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "B1 with the game engine optimizations in VERIFY mode: the original PlayMaker code runs as well and every difference is counted. Bolt work through the game's bolt events (loosen two turns, tighten one), 40 m and 2 km away and back, then a drive. Bolt stages are compared after each phase." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "true" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "engine0", "Seconds": 0, "Probes": [ "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "partsnap", "Label": "base", "Text": "reset" },

    { "Op": "repeat", "Label": "loosen", "Max": 2, "Steps": [
      { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM", "Fsm": "Screw", "Event": "UNTIGHTEN" },
      { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM", "Fsm": "Screw", "Event": "UNTIGHTEN" },
      { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/_Motor/BoltPM", "Fsm": "Screw", "Event": "UNTIGHTEN" },
      { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_alternator/alternator(Clone)/Bolts/BoltPM", "Fsm": "Screw", "Event": "UNTIGHTEN" },
      { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Chassis/FL/strut fl(xxxxx)/BoltPM", "Fsm": "Screw", "Event": "UNTIGHTEN" },
      { "Op": "wait", "Seconds": 1 }
    ] },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM", "Fsm": "Screw", "Event": "TIGHTEN" },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/_Motor/BoltPM", "Fsm": "Screw", "Event": "TIGHTEN" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "partsnap", "Label": "worked" },
    { "Op": "partcompare", "A": "base", "B": "worked" },

    { "Op": "repeat", "Label": "mid", "Max": 2, "Steps": [
      { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [40.0, 4.0, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
      { "Op": "wait", "Seconds": 8 },
      { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
      { "Op": "wait", "Seconds": 8 },
      { "Op": "partsnap", "Label": "mid{i}" },
      { "Op": "partcompare", "A": "worked", "B": "mid{i}" }
    ] },
    { "Op": "teleport", "Path": "GIFU(750/450psi)", "Local": true, "Pos": [6.0, 1.0, 0.0] },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "partsnap", "Label": "far" },
    { "Op": "partcompare", "A": "worked", "B": "far" },
    { "Op": "watch", "Label": "engine1", "Seconds": 0, "Probes": [ "engine=static|MOP.Next.Engine.EngineLab.Report" ] },

    { "Op": "log", "Text": "--- drive ---" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "partsnap", "Label": "placed" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Last": 17, "Speed": 45 },
    { "Op": "wait", "Seconds": 60 },
    { "Op": "watch", "Label": "driving", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "drivestop" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "partsnap", "Label": "driven" },
    { "Op": "partcompare", "A": "placed", "B": "driven" },
    { "Op": "watch", "Label": "engine2", "Seconds": 0, "Probes": [ "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "console", "Text": "mopr engine" },
    { "Op": "quit" }
  ]
}
