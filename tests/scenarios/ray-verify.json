{
  "Name": "ray-verify",
  "SettleSeconds": 3,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Shared mouse ray, second version (only DoMousePick replaced): verify at home (turning camera) and in the car, then A/B against the original (A = shared, B = Bypass), then the setting off and on." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "engineSharedMouseRay", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "true" },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [1.6, 1.5, 1.2], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "spin", "Speed": 40 },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "spin", "Speed": 0 },
    { "Op": "watch", "Label": "verify_car_turning", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters" ] },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.0, 2.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-1.2, 1.0, 0.4], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "watch", "Label": "verify_car_close", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters" ] },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-12.0, 2.0, 6.0], "Target": "YARD/Building" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "spin", "Speed": 60 },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "spin", "Speed": 0 },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "spin", "Speed": 60 },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "spin", "Speed": 0 },
    { "Op": "watch", "Label": "verify_home", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters", "engine=static|MOP.Next.Engine.EngineLab.Report" ] },

    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "false" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "abtoggle", "Label": "living-shared-ray", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 12, "Block": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-12.0, 2.0, 6.0], "Target": "YARD/Building" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "abtoggle", "Label": "yard-shared-ray", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [1.6, 1.5, 1.2], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "abtoggle", "Label": "car-shared-ray", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "on_standing", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters" ] },

    { "Op": "log", "Text": "--- in the car: Teimo's route ---" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "vehicle=global|PlayerCurrentVehicle" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "true" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "verify_seated", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters" ] },
    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Last": 17, "Speed": 45 },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "watch", "Label": "verify_driving", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters", "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "false" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "abtoggle", "Label": "driving-shared-ray", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "on_driving", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters", "driver=static|MOPR.TestBot.Driver.Status" ] },
    { "Op": "drivestop" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "engineSharedMouseRay", "Value": "false" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "watch", "Label": "setting_off", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "engineSharedMouseRay", "Value": "true" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "watch", "Label": "setting_on", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters" ] },
    { "Op": "quit" }
  ]
}
