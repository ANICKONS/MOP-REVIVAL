{
  "Name": "drive-attrib",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Shared mouse ray next to the car (turning camera, verify), then driving the Satsuma through Peraejaervi (Teimo's bicycle route, 60 km/h): mesh merger, shared ray, mirror cameras and car colliders A/B, camera and collider lists." },

    { "Op": "log", "Text": "--- standing 1.5 m from the open engine bay side, camera turning 40 deg/s ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [1.6, 1.5, 1.2], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "true" },
    { "Op": "spin", "Speed": 40 },
    { "Op": "wait", "Seconds": 12 },
    { "Op": "watch", "Label": "ray_verify_turning", "Seconds": 0, "Probes": [ "ray=static|MOP.Next.Engine.EngineLab.MouseRayCounters", "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "enginePlayMakerVerify", "Value": "false" },
    { "Op": "spin", "Speed": 0 },
    { "Op": "abtoggle", "Label": "standing-shared-ray-vs-original", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 20, "Block": 1 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "false" },

    { "Op": "log", "Text": "--- to Peraejaervi: car first, then the player, then get in ---" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "car_placed", "Seconds": 0, "Probes": [ "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "vehicle=global|PlayerCurrentVehicle" ] },
    { "Op": "cameralist", "Label": "cameras_seated" },
    { "Op": "colliderlist", "Label": "colliders_satsuma", "Path": "SATSUMA(557kg, 248)" },

    { "Op": "log", "Text": "--- driving ---" },
    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Speed": 60 },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "driving", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "vehicle=global|PlayerCurrentVehicle", "merge=static|MOP.Next.VehicleMeshMerge.Report", "moving=static|MOP.Next.VehicleMeshMerge.MovingSample" ] },
    { "Op": "screenshot", "Label": "driving" },
    { "Op": "measure", "Label": "driving", "Seconds": 8 },
    { "Op": "profile", "Label": "driving", "Seconds": 8 },
    { "Op": "callcount", "Label": "pick-driving", "Seconds": 4, "Text": "HutongGames.PlayMaker.ActionHelpers:DoMousePick,HutongGames.PlayMaker.ActionHelpers:MouseOver" },
    { "Op": "watch", "Label": "merge_driving", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "abtoggle", "Label": "driving-merged-vs-original", "Var": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Seconds": 20, "Block": 1 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "true" },
    { "Op": "abtoggle", "Label": "driving-shared-ray-vs-original", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 20, "Block": 1 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "false" },
    { "Op": "abtoggle", "Label": "driving-mirror-cameras", "Var": "cameras", "Path": "MirrorCam", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "driving-car-colliders", "Var": "colliders", "Path": "SATSUMA(557kg, 248)", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "driving_end", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "drivestop" },
    { "Op": "quit" }
  ]
}
