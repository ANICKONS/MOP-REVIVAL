{
  "Name": "settings-page",
  "StayInMenu": true,
  "MenuReadyTimeoutSeconds": 30,
  "Steps": [
    { "Op": "log", "Text": "Settings page review: Russian page top to bottom, the render main switch off (its settings hidden), the FPS limit on, then English." },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "opensettings", "Text": "MOPR" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "language", "Value": "1" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "scrollsettings", "Value": "1.0" },
    { "Op": "screenshot", "Label": "ru_00" },
    { "Op": "scrollsettings", "Value": "0.9" },
    { "Op": "screenshot", "Label": "ru_10" },
    { "Op": "scrollsettings", "Value": "0.8" },
    { "Op": "screenshot", "Label": "ru_20" },
    { "Op": "scrollsettings", "Value": "0.7" },
    { "Op": "screenshot", "Label": "ru_30" },
    { "Op": "scrollsettings", "Value": "0.6" },
    { "Op": "screenshot", "Label": "ru_40" },
    { "Op": "scrollsettings", "Value": "0.5" },
    { "Op": "screenshot", "Label": "ru_50" },
    { "Op": "scrollsettings", "Value": "0.4" },
    { "Op": "screenshot", "Label": "ru_60" },
    { "Op": "scrollsettings", "Value": "0.3" },
    { "Op": "screenshot", "Label": "ru_70" },
    { "Op": "scrollsettings", "Value": "0.2" },
    { "Op": "screenshot", "Label": "ru_80" },
    { "Op": "scrollsettings", "Value": "0.1" },
    { "Op": "screenshot", "Label": "ru_90" },
    { "Op": "scrollsettings", "Value": "0.0" },
    { "Op": "screenshot", "Label": "ru_99" },

    { "Op": "modsetting", "Text": "MOPR", "Var": "renderOptimizer", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "limitFramerate", "Value": "true" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "scrollsettings", "Value": "0.8" },
    { "Op": "screenshot", "Label": "ru_render_off" },
    { "Op": "scrollsettings", "Value": "0.6" },
    { "Op": "screenshot", "Label": "ru_render_off_b" },
    { "Op": "scrollsettings", "Value": "0.4" },
    { "Op": "screenshot", "Label": "ru_render_off_c" },
    { "Op": "scrollsettings", "Value": "0.25" },
    { "Op": "screenshot", "Label": "ru_render_off_d" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderOptimizer", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "limitFramerate", "Value": "false" },

    { "Op": "modsetting", "Text": "MOPR", "Var": "language", "Value": "0" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "scrollsettings", "Value": "1.0" },
    { "Op": "screenshot", "Label": "en_00" },
    { "Op": "scrollsettings", "Value": "0.8" },
    { "Op": "screenshot", "Label": "en_20" },
    { "Op": "scrollsettings", "Value": "0.6" },
    { "Op": "screenshot", "Label": "en_40" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "language", "Value": "1" },
    { "Op": "closesettings" },
    { "Op": "quit" }
  ]
}
