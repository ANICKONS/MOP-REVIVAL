{
  "Name": "gifu-engine",
  "SettleSeconds": 15,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Gifu driven by its own engine where the save left it: the player comes from 2 km away, the key goes in (as the ignition FSM does), parking brake off and air pressure up (no waiting for the compressor), the player gets in, the starter FSM starts the engine (key held), 1st gear, hand throttle 0.6. Does it drive off? Run with -Variant vanilla as well." },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "teleport", "Path": "GIFU(750/450psi)", "Local": true, "Pos": [-4.0, 1.0, 0.0], "Target": "GIFU(750/450psi)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "near", "Seconds": 0, "Probes": [
      "pos=GIFU(750/450psi)|@pos", "kin=GIFU(750/450psi)|#Rigidbody.isKinematic", "cd=GIFU(750/450psi)|#CarDynamics.enabled",
      "ax=GIFU(750/450psi)|#Axles.enabled", "coll=GIFU(750/450psi)/Colliders|@parent", "dist=GIFU(750/450psi)|@player" ] },

    { "Op": "activate", "Path": "GIFU(750/450psi)/LOD/Dashboard/KeyHole/Keys/Key", "Active": true },
    { "Op": "fsmset", "Path": "GIFU(750/450psi)/Dashboard/Knobs/Parking Brake", "Fsm": "Use", "Var": "Brake", "Value": "false" },
    { "Op": "fsmset", "Path": "GIFU(750/450psi)/Simulation/Airbrakes", "Fsm": "Air Pressure", "Var": "Pressure", "Value": "900" },

    { "Op": "teleport", "Path": "GIFU(750/450psi)/LOD/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmstate", "Path": "GIFU(750/450psi)/LOD/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Text": "Press return" },
    { "Op": "fsmevent", "Path": "GIFU(750/450psi)/LOD/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [
      "seat=GIFU(750/450psi)/LOD/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "vehicle=global|PlayerCurrentVehicle", "pos=GIFU(750/450psi)|@pos",
      "kin=GIFU(750/450psi)|#Rigidbody.isKinematic", "cd=GIFU(750/450psi)|#CarDynamics.enabled", "dist=GIFU(750/450psi)|@player" ] },

    { "Op": "fsmset", "Path": "GIFU(750/450psi)/Simulation/Starter", "Fsm": "Starter", "Var": "ACC", "Value": "true" },
    { "Op": "fsmset", "Path": "GIFU(750/450psi)/Simulation/Starter", "Fsm": "Starter", "Var": "Starting", "Value": "true" },
    { "Op": "wait", "Seconds": 10 },
    { "Op": "fsmset", "Path": "GIFU(750/450psi)/Simulation/Starter", "Fsm": "Starter", "Var": "Starting", "Value": "false" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "watch", "Label": "running", "Seconds": 0, "Probes": [
      "starter=GIFU(750/450psi)/Simulation/Starter|Starter|@state", "rpm=GIFU(750/450psi)|#Drivetrain.rpm", "gear=GIFU(750/450psi)|#Drivetrain.gear",
      "air=GIFU(750/450psi)/Simulation/Airbrakes|Air Pressure|@state", "park=GIFU(750/450psi)/Simulation/Airbrakes|Parking Brake|@state",
      "pos=GIFU(750/450psi)|@pos", "kin=GIFU(750/450psi)|#Rigidbody.isKinematic" ] },

    { "Op": "setmember", "Path": "GIFU(750/450psi)", "Var": "Drivetrain.gear", "Value": "2" },
    { "Op": "fsmset", "Path": "GIFU(750/450psi)/LOD/Dashboard/ButtonHandThrottle", "Fsm": "Use", "Var": "Throttle", "Value": "0.6" },
    { "Op": "fsmset", "Path": "GIFU(750/450psi)/LOD/Dashboard/ButtonHandThrottle", "Fsm": "Throttle", "Var": "Throttle", "Value": "0.6" },
    { "Op": "watch", "Label": "drive", "Seconds": 20, "Interval": 1, "Probes": [
      "pos=GIFU(750/450psi)|@pos", "vel=GIFU(750/450psi)|#Rigidbody.velocity", "rpm=GIFU(750/450psi)|#Drivetrain.rpm",
      "gear=GIFU(750/450psi)|#Drivetrain.gear", "thr=GIFU(750/450psi)|#Drivetrain.throttle", "idle=GIFU(750/450psi)|#Drivetrain.idlethrottle",
      "clutch=GIFU(750/450psi)|#AxisCarController.clutchInput", "brake=GIFU(750/450psi)|#AxisCarController.brake",
      "kin=GIFU(750/450psi)|#Rigidbody.isKinematic", "cd=GIFU(750/450psi)|#CarDynamics.enabled", "vehicle=global|PlayerCurrentVehicle" ] },
    { "Op": "screenshot", "Label": "gifu_engine" },
    { "Op": "quit" }
  ]
}
