    { "Op": "abtoggle", "Label": "40m-1000-dummies", "Var": "dummies", "Max": 1000, "Seconds": 16 },
    { "Op": "abtoggle", "Label": "40m-away-car-colliders", "Var": "colliders", "Path": "SATSUMA(557kg, 248)", "Seconds": 16 },
    { "Op": "quit" }
