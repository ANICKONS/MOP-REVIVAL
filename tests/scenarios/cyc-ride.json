{
  "Name": "cyc-ride",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Call Your Cousin user report: Pena's car doesn't move when the player gets in at the house. Call from home, wait until he stands at the house, get in as passenger (DriveTrigger, Key DOWN), then watch whether the car drives off. Run with -Variant vanilla and mopr. Needs CallYourCousin in the Mods folder." },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.3, 0.0] },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "cyc", "Text": "call" },
    { "Op": "cycwait", "Seconds": 150 },
    { "Op": "cyc", "Text": "state" },
    { "Op": "teleport", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "trigger", "Seconds": 0, "Probes": [ "state=TRAFFIC/VehiclesDirtRoad/Rally/FITTAN/PlayerTrigger/DriveTrigger|PlayerTrigger|@state" ] },
    { "Op": "fsmevent", "Path": "TRAFFIC/VehiclesDirtRoad/Rally/FITTAN/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "state=TRAFFIC/VehiclesDirtRoad/Rally/FITTAN/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "vehicle=global|PlayerCurrentVehicle" ] },
    { "Op": "repeat", "Label": "ride", "Max": 10, "Steps": [
      { "Op": "wait", "Seconds": 3 },
      { "Op": "cyc", "Text": "state" }
    ] },
    { "Op": "quit" }
  ]
}
