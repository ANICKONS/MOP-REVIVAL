{
  "Name": "yaim-tce2",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Fix check for the YAIM / Traffic Car Expansion report: items taken out of the YAIM inventory stay in front of the player, items in the inventory are not frozen and survive a save, the highway objects of Traffic Car Expansion are left to it. Needs YAIM and TrafficCarExpansion in the Mods folder." },
    { "Op": "tree", "Path": "TRAFFIC/VehiclesHighway", "Max": 1, "Label": "highway" },

    { "Op": "log", "Text": "--- bucket ---" },
    { "Op": "teleport", "Path": "ITEMS/bucket(itemx)", "Local": false, "Pos": [1.5, 0.5, 0.0], "Target": "ITEMS/bucket(itemx)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "yaim", "Text": "pickup", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "yaim", "Text": "drop", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "wait", "Seconds": 0.5 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/bucket(itemx)" },

    { "Op": "log", "Text": "--- sausages ---" },
    { "Op": "yaim", "Text": "pickup", "Path": "ITEMS/sausages(itemx)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/sausages(itemx)" },
    { "Op": "yaim", "Text": "drop", "Path": "ITEMS/sausages(itemx)" },
    { "Op": "wait", "Seconds": 0.5 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/sausages(itemx)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/sausages(itemx)" },

    { "Op": "log", "Text": "--- Traffic Car Expansion still spawns its cars on the highway ---" },
    { "Op": "teleport", "Path": "TRAFFIC/VehiclesHighway/TRUCK", "Local": false, "Pos": [0.0, 2.0, 8.0] },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "census", "Path": "TRAFFIC/VehiclesHighway/TrafficModCars" },
    { "Op": "tree", "Path": "TRAFFIC/VehiclesHighway", "Max": 1, "Label": "highway_out" },

    { "Op": "log", "Text": "--- fish trap and bucket in the inventory over a real save and load ---" },
    { "Op": "teleport", "Path": "ITEMS/bucket(itemx)", "Local": false, "Pos": [1.5, 0.5, 0.0], "Target": "ITEMS/bucket(itemx)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "yaim", "Text": "pickup", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "yaim", "Text": "pickup", "Path": "ITEMS/fish trap(itemx)" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.3, 0.0] },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/fish trap(itemx)" },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "savegame" },

    { "Op": "log", "Text": "loaded again after the save" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/fish trap(itemx)" },
    { "Op": "yaim", "Text": "state", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "call", "Text": "Ceres.YAIM.YAIM:Singleton.UnpackCachedColliders" },
    { "Op": "yaim", "Text": "drop", "Path": "ITEMS/fish trap(itemx)" },
    { "Op": "yaim", "Text": "drop", "Path": "ITEMS/bucket(itemx)" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "yaim", "Text": "state", "Path": "fish trap(itemx)" },
    { "Op": "yaim", "Text": "state", "Path": "bucket(itemx)" },
    { "Op": "console", "Text": "mopr log 30" },
    { "Op": "quit" }
  ]
}
