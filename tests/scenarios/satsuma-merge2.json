{
  "Name": "satsuma-merge2",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "MOPR mesh merger, views where the car is visible: front 6.5 m (physics frozen), front 3.5 m (physics on), side 8 m (car behind the house wall). Merged vs original in 1 s blocks, screenshots, and a hood hide/show while merged." },

    { "Op": "log", "Text": "--- front 6.5 m (physics frozen) ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, 6.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "f65_state", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "screenshot", "Label": "f65_merged" },
    { "Op": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Value": "true" },
    { "Op": "wait", "Seconds": 0.3 },
    { "Op": "screenshot", "Label": "f65_original" },
    { "Op": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Value": "false" },
    { "Op": "abtoggle", "Label": "f65-merged-vs-original", "Var": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Seconds": 24, "Block": 1 },
    { "Op": "watch", "Label": "f65_after_ab", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },

    { "Op": "log", "Text": "--- hood hidden / shown while merged (front 6.5 m) ---" },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)", "Active": false },
    { "Op": "screenshot", "Label": "hood_hidden_now" },
    { "Op": "watch", "Label": "after_hide", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "remerged_without_hood", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "screenshot", "Label": "hood_hidden_merged" },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)", "Active": true },
    { "Op": "screenshot", "Label": "hood_back_now" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "remerged_with_hood", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "screenshot", "Label": "hood_back_merged" },

    { "Op": "log", "Text": "--- front 3.5 m (physics on) ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.4, 3.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "f35_state", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "screenshot", "Label": "f35_merged" },
    { "Op": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Value": "true" },
    { "Op": "wait", "Seconds": 0.3 },
    { "Op": "screenshot", "Label": "f35_original" },
    { "Op": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Value": "false" },
    { "Op": "abtoggle", "Label": "f35-merged-vs-original", "Var": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Seconds": 24, "Block": 1 },
    { "Op": "watch", "Label": "f35_after_ab", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },

    { "Op": "log", "Text": "--- side 8 m (car behind the house wall) ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [8.0, 2.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "s8_state", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "abtoggle", "Label": "s8-merged-vs-original", "Var": "staticbool", "Path": "MOP.Next.VehicleMeshMerge.AbDrawOriginals", "Seconds": 24, "Block": 1 },
    { "Op": "watch", "Label": "s8_after_ab", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },

    { "Op": "log", "Text": "--- hood and engine bay structure (for hiding the engine bay from the driver's seat) ---" },
    { "Op": "dumpfsm", "Label": "hood", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)", "Recursive": false },
    { "Op": "tree", "Label": "pivot_hood", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood", "Max": 2 },
    { "Op": "tree", "Label": "motor", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot", "Max": 8 },
    { "Op": "census", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot" },
    { "Op": "watch", "Label": "hood_pose", "Seconds": 0, "Probes": [ "pos=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|@pos", "rot=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|#Transform.localEulerAngles", "lpos=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|#Transform.localPosition" ] },

    { "Op": "log", "Text": "--- save: the merger must hand every renderer back first ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, 6.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "before_save", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "hood=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|#MeshRenderer.enabled" ] },
    { "Op": "call", "Text": "MOP.Hypervisor:Instance.PreSaveGame" },
    { "Op": "watch", "Label": "after_presave", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "hood=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|#MeshRenderer.enabled", "report=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "quit" }
  ]
}
