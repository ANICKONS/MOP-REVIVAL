{
  "Name": "satsuma-doors",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Bug report: Satsuma parts vanish when a door is opened; after they come back, tires and front seat backs stay invisible. User settings: merger on, all experimental options on. Renderer states are compared with a baseline taken with the merger off." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "false" },

    { "Op": "log", "Text": "--- the car out of the garage, onto the yard ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [0.0, 1.5, 20.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "movecar", "Target": "SATSUMA(557kg, 248)", "Pos": [0.0, 0.3, 13.0] },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-4.5, 1.6, 0.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "placed", "Seconds": 0, "Probes": [ "pos=SATSUMA(557kg, 248)|@pos", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "rendstate", "Label": "base", "Path": "SATSUMA(557kg, 248)" },
    { "Op": "screenshot", "Label": "base" },
    { "Op": "dumpfsm", "Label": "door_left", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Recursive": false },
    { "Op": "tree", "Label": "door_left", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left", "Max": 3 },

    { "Op": "log", "Text": "--- merger on, 4.5 m from the driver's door (physics frozen) ---" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "true" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "merged", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "rendstate", "Label": "merged", "Path": "SATSUMA(557kg, 248)" },
    { "Op": "screenshot", "Label": "merged" },

    { "Op": "log", "Text": "--- step next to the door (physics on), open it, watch, close it; four times ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-2.3, 1.5, 0.6], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "near", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "merge=static|MOP.Next.VehicleMeshMerge.Report", "door=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)|#Transform.localEulerAngles" ] },
    { "Op": "push", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Target": "SATSUMA(557kg, 248)", "Pos": [-3.0, 0.0, 0.0] },
    { "Op": "watch", "Label": "open1", "Seconds": 3, "Interval": 0.25, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "door=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)|#Transform.localEulerAngles", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-4.5, 1.6, 0.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "screenshot", "Label": "open1" },
    { "Op": "rendstate", "Label": "open1", "Path": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "open1_later", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "screenshot", "Label": "open1_later" },
    { "Op": "rendstate", "Label": "open1_later", "Path": "SATSUMA(557kg, 248)" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-2.3, 1.5, 0.6], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "push", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Target": "SATSUMA(557kg, 248)", "Pos": [3.0, 0.0, 0.0] },
    { "Op": "watch", "Label": "close1", "Seconds": 3, "Interval": 0.25, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "door=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)|#Transform.localEulerAngles", "merge=static|MOP.Next.VehicleMeshMerge.Report" ] },
    { "Op": "wait", "Seconds": 6 },

    { "Op": "push", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Target": "SATSUMA(557kg, 248)", "Pos": [-3.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 7 },
    { "Op": "push", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Target": "SATSUMA(557kg, 248)", "Pos": [3.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 7 },
    { "Op": "push", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Target": "SATSUMA(557kg, 248)", "Pos": [-3.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "push", "Path": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)", "Target": "SATSUMA(557kg, 248)", "Pos": [3.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-4.5, 1.6, 0.5], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "cycles", "Seconds": 0, "Probes": [ "merged=static|MOP.Next.VehicleMeshMerge.IsSatsumaMerged", "merge=static|MOP.Next.VehicleMeshMerge.Report", "moving=static|MOP.Next.VehicleMeshMerge.MovingSample" ] },
    { "Op": "screenshot", "Label": "cycles" },
    { "Op": "rendstate", "Label": "cycles", "Path": "SATSUMA(557kg, 248)" },

    { "Op": "log", "Text": "--- merger off: everything must be back exactly as in the baseline ---" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "renderMergeVehicles", "Value": "false" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "rendstate", "Label": "off", "Path": "SATSUMA(557kg, 248)" },
    { "Op": "screenshot", "Label": "off" },
    { "Op": "rendcompare", "A": "base", "B": "merged" },
    { "Op": "rendcompare", "A": "base", "B": "open1" },
    { "Op": "rendcompare", "A": "base", "B": "open1_later" },
    { "Op": "rendcompare", "A": "base", "B": "cycles" },
    { "Op": "rendcompare", "A": "base", "B": "off" },
    { "Op": "quit" }
  ]
}
