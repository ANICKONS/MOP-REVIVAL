{
  "Name": "enginebay-home",
  "SettleSeconds": 15,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "'Hide the engine while driving' at home, where the save left the car: what the option does next to the car (player standing) and in the driver's seat, with screenshots. A/B of the option itself, and of switching every engine renderer off (what hiding the engine could save at most)." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "true" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "outside", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "bay=static|MOP.Next.EngineBayCulling.Report" ] },
    { "Op": "screenshot", "Label": "outside" },
    { "Op": "abtoggle", "Label": "outside-option", "Var": "staticbool", "Path": "MOP.Next.EngineBayCulling.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "outside-engine-renderers-off", "Var": "renderers", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "outside_after", "Seconds": 0, "Probes": [ "bay=static|MOP.Next.EngineBayCulling.Report" ] },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "bay=static|MOP.Next.EngineBayCulling.Report" ] },
    { "Op": "viewdiff", "Label": "seated", "Path": "MOP.Next.EngineBayCulling.Bypass", "Target": "SATSUMA(557kg, 248)" },
    { "Op": "abtoggle", "Label": "seated-option", "Var": "staticbool", "Path": "MOP.Next.EngineBayCulling.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "seated-engine-renderers-off", "Var": "renderers", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "seated_after", "Seconds": 0, "Probes": [ "bay=static|MOP.Next.EngineBayCulling.Report" ] },
    { "Op": "quit" }
  ]
}
