{
  "Name": "drive-bench3",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Experimental driving options in the Satsuma (Peraejaervi, Teimo's route waypoints 5-17, 45 km/h): engine bay hidden from the driver's seat (screenshots on/off with the hood on and off), mirrors at most 60 FPS and the shared mouse ray, each A/B against the original, seated and driving." },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "vehicle=global|PlayerCurrentVehicle", "pos=SATSUMA(557kg, 248)|@pos" ] },

    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "true" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "experimental_on", "Seconds": 0, "Probes": [ "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "viewdiff", "Label": "bay", "Path": "MOP.Next.EngineBayCulling.Bypass", "Target": "SATSUMA(557kg, 248)" },
    { "Op": "viewdiff", "Label": "mirrors", "Path": "MOP.Next.MirrorRate.Bypass", "Target": "SATSUMA(557kg, 248)" },

    { "Op": "log", "Text": "--- hood removed: the option must switch itself off ---" },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)", "Active": false },
    { "Op": "wait", "Seconds": 0.5 },
    { "Op": "watch", "Label": "nohood", "Seconds": 0, "Probes": [ "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "viewdiff", "Label": "nohood", "Path": "MOP.Next.EngineBayCulling.Bypass", "Target": "SATSUMA(557kg, 248)" },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)", "Active": true },
    { "Op": "wait", "Seconds": 1 },

    { "Op": "log", "Text": "--- seated, parked ---" },
    { "Op": "abtoggle", "Label": "seated-engine-bay", "Var": "staticbool", "Path": "MOP.Next.EngineBayCulling.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "seated-mirrors-60", "Var": "staticbool", "Path": "MOP.Next.MirrorRate.Bypass", "Seconds": 16, "Block": 1 },

    { "Op": "log", "Text": "--- driving ---" },
    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Last": 17, "Speed": 45 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "watch", "Label": "driving", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "abtoggle", "Label": "driving-engine-bay", "Var": "staticbool", "Path": "MOP.Next.EngineBayCulling.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "driving-mirrors-60", "Var": "staticbool", "Path": "MOP.Next.MirrorRate.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "true" },
    { "Op": "abtoggle", "Label": "driving-shared-ray", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "driving_mid", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "engine=static|MOP.Next.Engine.EngineLab.Report" ] },
    { "Op": "measure", "Label": "driving-all-experimental", "Seconds": 8 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "false" },
    { "Op": "measure", "Label": "driving-no-experimental", "Seconds": 8 },
    { "Op": "watch", "Label": "driving_end", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "screenshot", "Label": "driving_end" },
    { "Op": "drivestop" },
    { "Op": "quit" }
  ]
}
