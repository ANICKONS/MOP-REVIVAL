{
  "Name": "fg-measure",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Frame generation (NVIDIA Smooth Motion, driver profile) check: game frames (this log) against the images the monitor gets (tools/FrameCounter, run beside the game). Living room and driving 45 km/h, each with MOPR's limit at 60 FPS and without a limit, 15 s each. Run once with Smooth Motion on and once off." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "false" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.6, 0.0], "Yaw": 90 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "limitFramerate", "Value": "true" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "framerateLimiterUpdated", "Value": "60" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "log", "Text": "MARK home-60 start" },
    { "Op": "measure", "Label": "home-60", "Seconds": 15 },
    { "Op": "log", "Text": "MARK home-60 end" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "limitFramerate", "Value": "false" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "log", "Text": "MARK home-free start" },
    { "Op": "measure", "Label": "home-free", "Seconds": 15 },
    { "Op": "log", "Text": "MARK home-free end" },

    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Last": 17, "Speed": 45 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "limitFramerate", "Value": "true" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "log", "Text": "MARK drive-60 start" },
    { "Op": "measure", "Label": "drive-60", "Seconds": 15 },
    { "Op": "log", "Text": "MARK drive-60 end" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "limitFramerate", "Value": "false" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "log", "Text": "MARK drive-free start" },
    { "Op": "measure", "Label": "drive-free", "Seconds": 15 },
    { "Op": "log", "Text": "MARK drive-free end" },
    { "Op": "watch", "Label": "driving", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status" ] },
    { "Op": "drivestop" },
    { "Op": "quit" }
  ]
}
