{
  "Name": "satsuma-attrib",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Attribution of the FPS drop near the Satsuma: car rendering, its shadows, global shadows, car physics (5 m), the 20 m FSM group." },
    { "Op": "census", "Path": "SATSUMA(557kg, 248)" },

    { "Op": "log", "Text": "--- rendering, 8 m, looking at the car ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [8.0, 2.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "census", "Path": "SATSUMA(557kg, 248)" },
    { "Op": "measure", "Label": "8m-base", "Seconds": 6 },
    { "Op": "renderers", "Path": "SATSUMA(557kg, 248)", "Active": false },
    { "Op": "measure", "Label": "8m-car-not-drawn", "Seconds": 6 },
    { "Op": "renderers", "Path": "SATSUMA(557kg, 248)", "Active": true },
    { "Op": "castshadows", "Path": "SATSUMA(557kg, 248)", "Active": false },
    { "Op": "measure", "Label": "8m-car-no-shadows", "Seconds": 6 },
    { "Op": "castshadows", "Path": "SATSUMA(557kg, 248)", "Active": true },
    { "Op": "quality", "Var": "shadowDistance", "Value": "0" },
    { "Op": "measure", "Label": "8m-no-shadows-at-all", "Seconds": 6 },
    { "Op": "quality", "Var": "shadowDistance", "Value": "restore" },
    { "Op": "measure", "Label": "8m-base-again", "Seconds": 6 },
    { "Op": "profile", "Label": "8m-look", "Seconds": 6, "Detail": true },

    { "Op": "log", "Text": "--- car physics: 4 m (MOP turns it on) vs 6.5 m (off), looking away ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [4.0, 1.5, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "phys4", "Seconds": 0, "Probes": [ "dist=SATSUMA(557kg, 248)|@player", "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic", "cd=SATSUMA(557kg, 248)|#CarDynamics.enabled" ] },
    { "Op": "measure", "Label": "4m-physics-on", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [6.5, 1.5, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "phys65", "Seconds": 0, "Probes": [ "dist=SATSUMA(557kg, 248)|@player", "kin=SATSUMA(557kg, 248)|#Rigidbody.isKinematic", "cd=SATSUMA(557kg, 248)|#CarDynamics.enabled" ] },
    { "Op": "measure", "Label": "6.5m-physics-off", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [4.0, 1.5, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "4m-physics-on-2", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [6.5, 1.5, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "6.5m-physics-off-2", "Seconds": 6 },

    { "Op": "log", "Text": "--- 20 m FSM group (Chassis): 15 m vs 26 m, looking away ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [15.0, 3.0, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "15m-away", "Seconds": 6 },
    { "Op": "profile", "Label": "15m-away", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [26.0, 3.5, 0.0], "Target": "SATSUMA(557kg, 248)", "Yaw": 180 },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "26m-away", "Seconds": 6 },
    { "Op": "profile", "Label": "26m-away", "Seconds": 6 },
    { "Op": "quit" }
  ]
}
