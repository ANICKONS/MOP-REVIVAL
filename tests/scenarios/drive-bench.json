{
  "Name": "drive-bench",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Driving the Satsuma through Peraejaervi (Teimo's bicycle route from waypoint 5, 60 km/h): FPS, profile, and A/B of the shared mouse ray, the mirror cameras, all car renderers and the engine bay renderers (what hiding parts like SatsumaFpsOptimization could gain)." },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "vehicle=global|PlayerCurrentVehicle", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "screenshot", "Label": "seated" },
    { "Op": "abtoggle", "Label": "seated-engine-bay-renderers", "Var": "renderers", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot", "Seconds": 16, "Block": 1 },

    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Speed": 60 },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "driving", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "screenshot", "Label": "driving" },
    { "Op": "measure", "Label": "driving", "Seconds": 8 },
    { "Op": "profile", "Label": "driving", "Seconds": 8 },
    { "Op": "watch", "Label": "driving2", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "true" },
    { "Op": "abtoggle", "Label": "driving-shared-ray-vs-original", "Var": "staticbool", "Path": "MOP.Next.Engine.SharedMouseRay.Bypass", "Seconds": 20, "Block": 1 },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMouseRay", "Value": "false" },
    { "Op": "abtoggle", "Label": "driving-mirror-cameras", "Var": "cameras", "Path": "MirrorCam", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "driving-engine-bay-renderers", "Var": "renderers", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot", "Seconds": 16, "Block": 1 },
    { "Op": "abtoggle", "Label": "driving-car-renderers", "Var": "renderers", "Path": "SATSUMA(557kg, 248)", "Seconds": 16, "Block": 1 },
    { "Op": "watch", "Label": "driving_end", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "pos=SATSUMA(557kg, 248)|@pos" ] },
    { "Op": "screenshot", "Label": "driving_end" },
    { "Op": "drivestop" },
    { "Op": "quit" }
  ]
}
