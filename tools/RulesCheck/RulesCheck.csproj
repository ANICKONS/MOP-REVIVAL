<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RulesCheck: offline checks of the MOPR rule readers (src/MOPR/src/Rules, compiled in here as is).
      convert <legacyDir> <outDir>   old .mopconfig files -> JSON rule files
      verify  <legacyDir> <jsonDir>  every JSON file must say exactly what its .mopconfig said
      selftest                       parser edge cases
    Run: scripts\rules-check.ps1
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>MOP</RootNamespace>
    <!-- The game's Newtonsoft.Json (13.0, the build MSCLoader ships). -->
    <ManagedDir Condition=" '$(ManagedDir)' == '' ">D:\SteamLibrary\steamapps\common\My Summer Car\mysummercar_Data\Managed</ManagedDir>
    <NewtonsoftPath Condition=" '$(NewtonsoftPath)' == '' And Exists('$(ManagedDir)\Newtonsoft.Json.dll') ">$(ManagedDir)\Newtonsoft.Json.dll</NewtonsoftPath>
    <NewtonsoftPath Condition=" '$(NewtonsoftPath)' == '' ">$(MSBuildThisFileDirectory)..\..\refs\cache\MSCLoader\Newtonsoft.Json.dll</NewtonsoftPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MOPR\src\Rules\RuleSet.cs" Link="Rules\RuleSet.cs" />
    <Compile Include="..\..\src\MOPR\src\Rules\LegacyRules.cs" Link="Rules\LegacyRules.cs" />
    <Compile Include="..\..\src\MOPR\src\Rules\RuleJson.cs" Link="Rules\RuleJson.cs" />
    <Compile Include="..\..\src\MOPR\src\Rules\RuleBook.cs" Link="Rules\RuleBook.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>

</Project>
