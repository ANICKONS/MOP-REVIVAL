{
  "Name": "bolt-sleep",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Sleeping bolts while driving (MOPR 5.1.1, experimental): seated in the Satsuma in Peraejaervi the idle per-bolt Screw FSMs are paused. Checked: how many sleep, the frame time (A/B with the bypass, parked and driving), every way an event reaches a sleeping bolt (direct event, event to a GameObject and its children, broadcast static and from an FSM), its object switched off and on, someone else enabling it, the game's EnableFSM (the carburettor's Removal FSM, then the carburettor removed), getting out (everything awake, nothing changed), save and load. Bolt snapshots (stage, state, collider, bolt position, restart flag) for a comparison with -Variant vanilla." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalBoltSleep", "Value": "true" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "watch", "Label": "outside", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "boltsnap", "Label": "pre" },

    { "Op": "log", "Text": "--- seated ---" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "sleep=static|MOP.Next.Engine.BoltSleep.Report",
      "hood=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state" ] },
    { "Op": "boltsnap", "Label": "seated" },
    { "Op": "boltcompare", "A": "pre", "B": "seated" },
    { "Op": "abtoggle", "Label": "seated-bolts-awake", "Var": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Seconds": 20, "Block": 1 },
    { "Op": "wait", "Seconds": 2 },

    { "Op": "log", "Text": "--- events to sleeping bolts ---" },
    { "Op": "watch", "Label": "hood0", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "tight=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|BoltCheck|Tightness" ] },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM", "Fsm": "Screw", "Event": "UNTIGHTEN" },
    { "Op": "watch", "Label": "hood1", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "tight=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)|BoltCheck|Tightness" ] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "hood2", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "watch", "Label": "door0", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|Stage", "tight=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)|BoltCheck|Tightness" ] },
    { "Op": "sendtogo", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Target": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM", "Event": "UNTIGHTEN", "Active": false },
    { "Op": "watch", "Label": "door1", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|Stage", "tight=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)|BoltCheck|Tightness" ] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "sendtogo", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Target": "SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts", "Event": "TIGHTEN", "Active": true },
    { "Op": "watch", "Label": "door2", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|Stage", "tight=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)|BoltCheck|Tightness",
      "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "boltsnap", "Label": "events" },
    { "Op": "boltcompare", "A": "seated", "B": "events" },

    { "Op": "log", "Text": "--- tool mode broadcasts ---" },
    { "Op": "broadcast", "Event": "REPAIRMODE_ON" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "boltsnap", "Label": "repair_on" },
    { "Op": "boltcompare", "A": "events", "B": "repair_on" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "repair_on", "Seconds": 0, "Probes": [ "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "broadcast", "Event": "REPAIRMODE_OFF", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "boltsnap", "Label": "repair_off" },
    { "Op": "boltcompare", "A": "repair_on", "B": "repair_off" },
    { "Op": "wait", "Seconds": 2 },

    { "Op": "log", "Text": "--- a sleeping bolt's object switched off and on ---" },
    { "Op": "watch", "Label": "hood_before_off", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts", "Active": false },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts", "Active": true },
    { "Op": "watch", "Label": "hood_back", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "watch", "Label": "hood_back2", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage" ] },
    { "Op": "boltsnap", "Label": "reactivated" },
    { "Op": "boltcompare", "A": "repair_off", "B": "reactivated" },

    { "Op": "log", "Text": "--- someone else enables a sleeping bolt (object on; object switched off meanwhile) ---" },
    { "Op": "watch", "Label": "ext0", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state" ] },
    { "Op": "setmember", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM", "Var": "PlayMakerFSM.enabled", "Value": "true" },
    { "Op": "watch", "Label": "ext1", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts", "Active": false },
    { "Op": "setmember", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM", "Var": "PlayMakerFSM.enabled", "Value": "true" },
    { "Op": "activate", "Path": "SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts", "Active": true },
    { "Op": "watch", "Label": "ext2", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "boltsnap", "Label": "external" },
    { "Op": "boltcompare", "A": "reactivated", "B": "external" },

    { "Op": "log", "Text": "--- what the hooks cost (calls per frame, seated, bolts asleep) and who addresses Screw FSMs ---" },
    { "Op": "callcount", "Label": "hooks", "Seconds": 10, "Text": "MOP.Next.Engine.BoltSleep:ProcessEventPrefix,MOP.Next.Engine.BoltSleep:BroadcastPrefix,MOP.Next.Engine.BoltSleep:ToGameObjectPrefix,MOP.Next.Engine.BoltSleep:ToFsmOnGameObjectPrefix,MOP.Next.Engine.BoltSleep:FindFsmPrefix,MOP.Next.Engine.BoltSleep:Tick" },
    { "Op": "fsmgrep", "Label": "screw", "Text": "\"Screw\",BoltPM", "Max": 400 },

    { "Op": "log", "Text": "--- driving ---" },
    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Last": 17, "Speed": 45 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "abtoggle", "Label": "driving-bolts-awake", "Var": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Seconds": 40, "Block": 1 },
    { "Op": "watch", "Label": "driving_end", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "drivestop" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "boltsnap", "Label": "seated_end" },
    { "Op": "boltcompare", "A": "external", "B": "seated_end" },

    { "Op": "log", "Text": "--- the game's EnableFSM on a sleeping bolt: the carburettor's Removal FSM enables its bolt in Mouse off and disables it in Remove part ---" },
    { "Op": "watch", "Label": "carb0", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)/BoltPM|Screw|@state",
      "removal=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)|Removal|@state" ] },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)", "Fsm": "Removal", "Text": "Mouse off" },
    { "Op": "watch", "Label": "carb1", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)/BoltPM|Screw|@state",
      "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "carb2", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)/BoltPM|Screw|@state" ] },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)", "Fsm": "Removal", "Text": "Remove part" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "watch", "Label": "carb3", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)/BoltPM|Screw|@state",
      "stage=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)/BoltPM|Screw|Stage",
      "parent=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)|@parent",
      "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },

    { "Op": "log", "Text": "--- getting out ---" },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "out", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "trigger=SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger|PlayerTrigger|@state", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "watch", "Label": "carb_out", "Seconds": 0, "Probes": [ "state=SATSUMA(557kg, 248)/Chassis/sub frame(xxxxx)/CarMotorPivot/block(Clone)/pivot_cylinder head/cylinder head(Clone)/pivot_carburator/carburator(Clone)/BoltPM|Screw|@state" ] },
    { "Op": "boltsnap", "Label": "out" },
    { "Op": "boltcompare", "A": "seated_end", "B": "out" },

    { "Op": "log", "Text": "--- save and load ---" },
    { "Op": "teleport", "Path": "YARD/Building/LIVINGROOM/LOD_livingroom/SAVEGAME", "Pos": [0.0, 0.3, 0.0] },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "savegame" },
    { "Op": "log", "Text": "loaded again after the save" },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 8 },
    { "Op": "watch", "Label": "loaded", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "sleep=static|MOP.Next.Engine.BoltSleep.Report",
      "hood=SATSUMA(557kg, 248)/Body/pivot_hood/hood(Clone)/Bolts/BoltPM|Screw|Stage", "door=SATSUMA(557kg, 248)/Body/pivot_door_left/door left(Clone)/Bolts/BoltPM|Screw|Stage" ] },
    { "Op": "boltsnap", "Label": "loaded" },
    { "Op": "boltcompare", "A": "out", "B": "loaded" },
    { "Op": "quit" }
  ]
}
