{
  "Name": "bolt-sleep-drive",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "Sleeping bolts while driving, the driving numbers: 45 km/h on Teimo's route in Peraejaervi, 40 s A/B blocks of 1 s. Sleeping bolts against awake (bypass); for reference all Screw FSMs switched off and all 631 FSMs of the car switched off (the most any FSM pausing could give); the same at 640x360 (if the gain grows, the frame waits for the GPU or the render thread while driving, not for the scripts)." },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalEngineBay", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalMirrorRate", "Value": "false" },
    { "Op": "modsetting", "Text": "MOPR", "Var": "experimentalBoltSleep", "Value": "true" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5 },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "watch", "Label": "seated", "Seconds": 0, "Probes": [ "vehicle=global|PlayerCurrentVehicle", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },

    { "Op": "drive", "Target": "SATSUMA(557kg, 248)", "Path": "Waypoint Manager/TeimoBicycleIn", "Max": 5, "Last": 17, "Speed": 45 },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "log", "Text": "--- 1280x720 ---" },
    { "Op": "abtoggle", "Label": "drive-bolts-awake", "Var": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Seconds": 40, "Block": 1 },
    { "Op": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Value": "true" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "abtoggle", "Label": "drive-screw-fsms-off", "Var": "fsms", "Path": "SATSUMA(557kg, 248)", "Text": "BoltPM*", "Seconds": 40, "Block": 1 },
    { "Op": "abtoggle", "Label": "drive-all-car-fsms-off", "Var": "behaviours", "Path": "SATSUMA(557kg, 248)", "Text": "PlayMakerFSM", "Seconds": 40, "Block": 1 },
    { "Op": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Value": "false" },
    { "Op": "watch", "Label": "driving1", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },

    { "Op": "log", "Text": "--- 640x360 ---" },
    { "Op": "resolution", "Pos": [640, 360] },
    { "Op": "abtoggle", "Label": "drive-low-bolts-awake", "Var": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Seconds": 40, "Block": 1 },
    { "Op": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Value": "true" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "abtoggle", "Label": "drive-low-all-car-fsms-off", "Var": "behaviours", "Path": "SATSUMA(557kg, 248)", "Text": "PlayMakerFSM", "Seconds": 40, "Block": 1 },
    { "Op": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Value": "false" },
    { "Op": "watch", "Label": "driving2", "Seconds": 0, "Probes": [ "driver=static|MOPR.TestBot.Driver.Status", "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "drivestop" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "log", "Text": "--- parked, 640x360 ---" },
    { "Op": "abtoggle", "Label": "parked-low-bolts-awake", "Var": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Seconds": 20, "Block": 1 },
    { "Op": "resolution", "Pos": [1280, 720] },
    { "Op": "abtoggle", "Label": "parked-bolts-awake", "Var": "staticbool", "Path": "MOP.Next.Engine.BoltSleep.Bypass", "Seconds": 20, "Block": 1 },
    { "Op": "watch", "Label": "end", "Seconds": 0, "Probes": [ "sleep=static|MOP.Next.Engine.BoltSleep.Report" ] },
    { "Op": "quit" }
  ]
}
